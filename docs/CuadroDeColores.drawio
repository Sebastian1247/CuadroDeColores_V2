          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ConsolaCuadros usa el tablero para dibujarlo -->
        <mxCell id="e-consola-tablero" edge="1" parent="1" source="consola" target="tablero" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.515;entryY=0;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;endSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BuscadorBFS crea nodos -->
        <mxCell id="e-bfs-nodo" edge="1" parent="1" source="bfs" target="nodo" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.453;entryY=0;entryDx=0;entryDy=0;dashed=1;endArrow=open;endFill=0;endSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nodo contiene un tablero (estado) -->
        <mxCell id="e-nodo-tablero" edge="1" parent="1" source="nodo" target="tablero" value="contiene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.751;entryDx=0;entryDy=0;endArrow=open;endFill=0;endSize=12;">
