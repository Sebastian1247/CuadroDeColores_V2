          <mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-4" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Movimiento parte de una posicion y va hacia una direccion -->
        <mxCell id="e-mov-pos" edge="1" parent="1" source="mov" target="pos" value="parte de" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;endArrow=open;endFill=0;endSize=12;">
